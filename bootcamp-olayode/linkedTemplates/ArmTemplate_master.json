{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "bootcamp-olayode"
		},
		"Projectazureblobstorage_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'Projectazureblobstorage'"
		},
		"crypto_Snowflake_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'crypto_Snowflake'"
		},
		"projectsnowflake_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'projectsnowflake'"
		},
		"Projectrestservice_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://wttr.in"
		},
		"crypto_Snowflake_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "olayode_ingestion"
		},
		"crypto_api_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://api.coingecko.com"
		},
		"projectsnowflake_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "olayode_general_db"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "bootcamp-olayode_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"Projectazureblobstorage_connectionString": {
						"value": "[parameters('Projectazureblobstorage_connectionString')]"
					},
					"crypto_Snowflake_password": {
						"value": "[parameters('crypto_Snowflake_password')]"
					},
					"projectsnowflake_password": {
						"value": "[parameters('projectsnowflake_password')]"
					},
					"Projectrestservice_properties_typeProperties_url": {
						"value": "[parameters('Projectrestservice_properties_typeProperties_url')]"
					},
					"crypto_Snowflake_properties_typeProperties_database": {
						"value": "[parameters('crypto_Snowflake_properties_typeProperties_database')]"
					},
					"crypto_api_properties_typeProperties_url": {
						"value": "[parameters('crypto_api_properties_typeProperties_url')]"
					},
					"projectsnowflake_properties_typeProperties_database": {
						"value": "[parameters('projectsnowflake_properties_typeProperties_database')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}